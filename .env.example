# "supabase" for the real deployment, "local" stores data in ./.data (for trying it on your laptop)
DATA_MODE=supabase

# Supabase project settings (Project Settings -> API). Keep the service role key secret!
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin (umpire) login
ADMIN_USERNAME=umpire
ADMIN_PASSWORD=choose-a-strong-password
# Any long random string, used to sign the admin login cookie
SESSION_SECRET=replace-with-a-long-random-string
