# "supabase" for the real deployment, "local" stores data in ./.data (for trying it on your laptop)
DATA_MODE=supabase

# Supabase project settings (Project Settings -> API). Keep the service role key secret!
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Super admin login (full access, including correcting previous Sundays)
ADMIN_USERNAME=umpire
ADMIN_PASSWORD=choose-a-strong-password
# Optional second login with the "admin" role (runs today's games; previous Sundays are view-only)
SECOND_ADMIN_USERNAME=scorer
SECOND_ADMIN_PASSWORD=choose-another-strong-password
# Any long random string, used to sign the admin login cookie
SESSION_SECRET=replace-with-a-long-random-string
